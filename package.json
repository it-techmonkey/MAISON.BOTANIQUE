{
  "name": "maison-botanique-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "shopify:auth": "node --env-file-if-exists=.env.local scripts/shopify-auth.mjs",
    "theme:zip": "node scripts/theme-zip.mjs",
    "shopify:catalog": "node --env-file-if-exists=.env.local scripts/shopify-catalog-sync.mjs",
    "catalog:prices": "python scripts/match_prices.py"
  },
  "dependencies": {
    "@shopify/hydrogen": "2026.10.1",
    "next": "^16.4.2",
    "posthog-js": "1.438.12",
    "posthog-node": "5.56.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
