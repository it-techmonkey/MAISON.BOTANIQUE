{%- comment -%} While the online store is password protected, send visitors to the website too. {%- endcomment -%}
{%- assign base = settings.headless_url | default: 'https://maisonbotaniqueflowers.com' | remove_last: '/' -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    <meta http-equiv="refresh" content="0; url={{ base }}">
    <script>window.location.replace({{ base | json }});</script>
    {{ content_for_header }}
  </head>
  <body>
    <p><a href="{{ base }}">{{ 'general.continue' | t }}</a></p>
    <div hidden>{{ content_for_layout }}</div>
  </body>
</html>
