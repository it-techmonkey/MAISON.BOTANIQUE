{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }} gift card</title>
    {{ content_for_header }}
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F5F2EB; color: #26332B; font: 16px/1.5 Georgia, serif; text-align: center; }
      .card { max-width: 420px; padding: 40px; border: 1px solid rgba(38, 51, 43, .3); }
      code { display: block; margin: 16px 0; font-size: 22px; letter-spacing: .08em; }
    </style>
  </head>
  <body>
    <div class="card">
      <p>{{ shop.name }}</p>
      <h1>{{ gift_card.balance | money }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p>This gift card is no longer active.</p>{%- endif -%}
      <code>{{ gift_card.code | format_code }}</code>
      {%- if gift_card.expires_on -%}<p>Valid until {{ gift_card.expires_on | date: '%d %B %Y' }}</p>{%- endif -%}
      <p><a href="{{ settings.headless_url | default: 'https://maisonbotaniqueflowers.com' }}">Shop at Maison Botanique</a></p>
    </div>
  </body>
</html>
