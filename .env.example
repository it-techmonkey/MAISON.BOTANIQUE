# Set these only after a Shopify store and real product variants exist.
# The Storefront access token is public by Shopify design. Never put Admin API credentials in Vite variables.
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
VITE_SHOPIFY_API_VERSION=2026-10

# WhatsApp Business number in international format, digits only (for example 9715XXXXXXXX).
# Leave empty to hide every WhatsApp link on the site.
VITE_WHATSAPP_NUMBER=
