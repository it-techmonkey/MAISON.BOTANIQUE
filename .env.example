# Copy to .env.local for development, and set the same values in your host
# (except the SHOPIFY_ADMIN_* pair, which stays on your machine).
# Leave the two required Shopify values empty to run the sample-catalog preview.
# Setting only one of them is an error, so a live site never shows sample prices.

# --- Required for the live store ---------------------------------------------
# Shopify admin > Sales channels > Headless > your storefront > Storefront API.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# --- Recommended (server only) -----------------------------------------------
# Same page, "Private access token". Used for catalog requests on the server.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Settings > Notifications > Webhooks: "Your webhooks will be signed with …".
# Verifies the catalog webhook (/api/revalidate) and the order webhook (/api/webhooks/orders).
SHOPIFY_WEBHOOK_SECRET=

# --- Shopify analytics (optional) ----------------------------------------------
# Numeric shop ID and the Headless storefront ID. Shopify analytics stay off
# until SHOP_ID is set. Delivery then follows Shopify's Customer Privacy
# default for the visitor's region (Settings > Customer privacy).
NEXT_PUBLIC_SHOPIFY_SHOP_ID=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID=

# --- PostHog (optional) --------------------------------------------------------
# Project API key (PostHog > Project settings; starts with phc_). PostHog stays
# off until it is set. Traffic is relayed through /mb-relay on this domain.
NEXT_PUBLIC_POSTHOG_KEY=
# The project's cloud region: us (default) or eu.
NEXT_PUBLIC_POSTHOG_REGION=us

# --- Website forms (optional) -------------------------------------------------
# Newsletter, contact and enquiry forms are stored in Shopify (customers and
# "Website enquiry" metaobjects). Written by `npm run shopify:auth -- --forms`
# (docs/SHOPIFY_SETUP.md, step 13). This one Admin value DOES go on the host;
# its app can only touch customers and metaobjects. Empty: the forms offer a
# prefilled email instead.
SHOPIFY_FORMS_ADMIN_TOKEN=

# --- Site ----------------------------------------------------------------------
# Public URL of this website (used for absolute links in page metadata).
NEXT_PUBLIC_SITE_URL=https://maisonbotaniqueflowers.com
# Keep false until launch so search engines do not index the site.
SITE_INDEXABLE=false

# --- Admin API: seed script only. Local machine only; never on the host. ------
# Dev Dashboard app > Settings > Credentials (docs/SHOPIFY_SETUP.md, step 5A).
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Filled in automatically by `npm run shopify:auth`. Do not edit by hand.
SHOPIFY_ADMIN_REFRESH_TOKEN=

# --- Forms app: authorization only. Local machine only; never on the host. ------
# A second Dev Dashboard app with customer and metaobject scopes (step 13).
SHOPIFY_FORMS_CLIENT_ID=
SHOPIFY_FORMS_CLIENT_SECRET=

# Customer accounts: sign-in, order history and faster checkout (docs/SHOPIFY_SETUP.md step 14).
# Client ID from Sales channels > Headless > your storefront > Customer Account API.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Encrypts the session cookie. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Changing it signs everyone out.
CUSTOMER_ACCOUNT_SESSION_SECRET=

# Floating WhatsApp button and WhatsApp links: digits in international format,
# e.g. 9715XXXXXXXX. Hidden while empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Welcome offer code shown after the sign-up (create it in Shopify Discounts, one use per customer).
NEXT_PUBLIC_LAUNCH_OFFER_CODE=BLOOM25
